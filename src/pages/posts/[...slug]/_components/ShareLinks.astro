---
import config from "@/config";
import { useTranslations } from "@/i18n";

const t = useTranslations(Astro.currentLocale);
const pageUrl = Astro.url.href;
---

<div class="flex flex-none flex-col items-center justify-center gap-2 md:items-start">
  <span class="italic">{t.post.sharePostIntro}</span>
  <div class="flex flex-wrap items-center gap-3">
    <button
      type="button"
      class="border-border bg-background hover:border-accent hover:text-accent inline-flex items-center rounded-full border px-3 py-1.5 text-sm transition-colors"
      data-copy-link
      data-url={pageUrl}
      title="复制文章链接"
      aria-label="复制文章链接"
    >
      <span>复制链接</span>
    </button>
    <button
      type="button"
      class="border-border bg-background hover:border-accent hover:text-accent inline-flex items-center rounded-full border px-3 py-1.5 text-sm transition-colors"
      data-export-image
      title="生成长图"
      aria-label="生成长图"
    >
      <span>生成长图</span>
    </button>
  </div>
  <span class="text-muted-foreground min-h-[1rem] text-xs" data-share-feedback></span>
</div>

<div
  id="share-export-modal"
  class="fixed inset-0 z-50 hidden items-center justify-center bg-black/55 p-4 backdrop-blur-sm"
  aria-hidden="true"
>
  <div class="bg-background border-border flex max-h-[92vh] w-full max-w-6xl flex-col rounded border shadow-xl">
    <div class="border-border flex flex-wrap items-center justify-between gap-3 border-b px-4 py-3">
      <div>
        <h2 class="text-foreground text-base font-semibold">导出长图</h2>
        <p class="text-muted-foreground text-xs">选择社交媒体尺寸和样式后导出 PNG</p>
      </div>
      <button
        type="button"
        class="border-border hover:border-accent hover:text-accent rounded border px-3 py-1.5 text-sm"
        data-export-close
      >
        关闭
      </button>
    </div>

    <div class="border-border flex flex-wrap items-end gap-4 border-b px-4 py-3">
      <label class="flex flex-col gap-1 text-sm">
        <span class="text-muted-foreground text-xs">尺寸</span>
        <select
          class="border-border bg-background text-foreground rounded border px-3 py-2 text-sm"
          data-export-size
        >
          <option value="720">720px · 轻量分享</option>
          <option value="960" selected>960px · 长文默认</option>
          <option value="1080">1080px · 小红书/Instagram</option>
          <option value="1200">1200px · 高清长图</option>
        </select>
      </label>

      <label class="flex flex-col gap-1 text-sm">
        <span class="text-muted-foreground text-xs">样式</span>
        <select
          class="border-border bg-background text-foreground rounded border px-3 py-2 text-sm"
          data-export-theme
        >
          <option value="light" selected>浅色论文风</option>
          <option value="dark">深色技术风</option>
          <option value="minimal">简洁白底</option>
        </select>
      </label>

      <button
        type="button"
        class="bg-accent text-accent-foreground rounded px-4 py-2 text-sm font-medium"
        data-export-download
      >
        导出 PNG
      </button>
    </div>

    <div class="min-h-0 flex-1 overflow-auto p-4">
      <div
        id="share-export-stage"
        class="mx-auto origin-top"
      >
      <div
        id="share-export-root"
        class="share-export-card bg-background text-foreground w-[960px] shadow-lg"
      >
        <div class="share-export-header">
          <p class="share-export-brand">{config.site.title}</p>
          <div id="share-export-title" class="share-export-title"></div>
          <div id="share-export-meta" class="share-export-meta"></div>
          <ul id="share-export-tags" class="share-export-tags"></ul>
          <p class="share-export-url">{pageUrl}</p>
        </div>
        <div
          id="share-export-content"
          class="share-export-content app-prose max-w-none"
        ></div>
      </div>
      </div>
    </div>
  </div>
</div>

<style>
  #share-export-stage {
    width: var(--export-width, 960px);
  }

  .share-export-card {
    --export-pad: 48px;
    --export-title-size: 38px;
    --export-h2-size: 27px;
    --export-h3-size: 21px;
    --export-body-size: 17px;
    --export-code-size: 13px;
    --export-line-height: 1.78;
    --export-block-gap: 1.25em;
    padding: var(--export-pad);
    background: var(--background);
    color: var(--foreground);
  }

  .share-export-card[data-export-card-size="720"] {
    --export-pad: 34px;
    --export-title-size: 28px;
    --export-h2-size: 22px;
    --export-h3-size: 18px;
    --export-body-size: 14.5px;
    --export-code-size: 11.5px;
    --export-line-height: 1.72;
    --export-block-gap: 1.1em;
  }

  .share-export-card[data-export-card-size="960"] {
    --export-pad: 48px;
    --export-title-size: 38px;
    --export-h2-size: 27px;
    --export-h3-size: 21px;
    --export-body-size: 17px;
    --export-code-size: 13px;
    --export-line-height: 1.78;
    --export-block-gap: 1.25em;
  }

  .share-export-card[data-export-card-size="1080"] {
    --export-pad: 58px;
    --export-title-size: 42px;
    --export-h2-size: 30px;
    --export-h3-size: 23px;
    --export-body-size: 18px;
    --export-code-size: 13.5px;
    --export-line-height: 1.78;
    --export-block-gap: 1.3em;
  }

  .share-export-card[data-export-card-size="1200"] {
    --export-pad: 68px;
    --export-title-size: 46px;
    --export-h2-size: 32px;
    --export-h3-size: 24px;
    --export-body-size: 19px;
    --export-code-size: 14px;
    --export-line-height: 1.8;
    --export-block-gap: 1.35em;
  }

  .share-export-header {
    margin-bottom: calc(var(--export-pad) * 0.62);
    border-bottom: 1px solid var(--border);
    padding-bottom: calc(var(--export-pad) * 0.48);
  }

  .share-export-brand,
  .share-export-meta,
  .share-export-url {
    color: var(--muted-foreground);
  }

  .share-export-brand {
    margin: 0;
    font-size: calc(var(--export-body-size) * 0.9);
  }

  .share-export-title {
    margin-top: 0.38em;
    color: var(--accent);
    font-size: var(--export-title-size);
    font-weight: 800;
    letter-spacing: 0;
    line-height: 1.18;
  }

  .share-export-title :global(*) {
    color: inherit;
    font-size: inherit;
    line-height: inherit;
  }

  .share-export-meta {
    margin-top: 1em;
    font-size: calc(var(--export-body-size) * 0.95);
  }

  .share-export-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7em;
    margin: 1.1em 0 0;
    padding: 0;
    list-style: none;
    font-size: calc(var(--export-body-size) * 0.9);
  }

  .share-export-tags :global(a) {
    color: var(--foreground);
  }

  .share-export-url {
    margin: 1.3em 0 0;
    word-break: break-all;
    font-size: calc(var(--export-body-size) * 0.82);
  }

  .share-export-content {
    font-size: var(--export-body-size);
    line-height: var(--export-line-height);
    color: var(--foreground);
  }

  .share-export-content :global(h1),
  .share-export-content :global(h2),
  .share-export-content :global(h3),
  .share-export-content :global(h4) {
    color: var(--foreground);
    letter-spacing: 0;
    line-height: 1.35;
  }

  .share-export-content :global(h2) {
    margin: 1.75em 0 0.72em;
    font-size: var(--export-h2-size);
    font-weight: 800;
  }

  .share-export-content :global(h3) {
    margin: 1.45em 0 0.62em;
    font-size: var(--export-h3-size);
    font-style: italic;
    font-weight: 700;
  }

  .share-export-content :global(p),
  .share-export-content :global(ol),
  .share-export-content :global(ul),
  .share-export-content :global(table),
  .share-export-content :global(blockquote) {
    margin-top: var(--export-block-gap);
    margin-bottom: var(--export-block-gap);
    color: var(--foreground);
  }

  .share-export-content :global(li) {
    margin: 0.35em 0;
    padding-left: 0.15em;
  }

  .share-export-content :global(li::marker) {
    color: var(--accent);
  }

  .share-export-content :global(strong) {
    color: var(--foreground);
    font-weight: 800;
  }

  .share-export-content :global(a) {
    color: var(--accent);
    text-decoration-color: var(--accent);
  }

  .share-export-content :global(img) {
    display: block;
    max-width: min(100%, calc(var(--export-width, 960px) - var(--export-pad) * 2));
    height: auto;
    margin: 1.8em auto;
    border: 1px solid var(--border);
    background: #fff;
  }

  .share-export-content :global(table) {
    width: 100%;
    border-collapse: collapse;
    font-size: calc(var(--export-body-size) * 0.88);
  }

  .share-export-content :global(th),
  .share-export-content :global(td) {
    border: 1px solid var(--border);
    padding: 0.62em 0.72em;
    color: var(--foreground);
  }

  .share-export-content :global(th) {
    background: var(--muted);
    font-weight: 750;
  }

  .share-export-content :global(code) {
    border-radius: 4px;
    background: var(--muted);
    color: var(--foreground);
    font-size: calc(var(--export-code-size) * 0.98);
    padding: 0.14em 0.36em;
  }

  .share-export-content :global(pre) {
    margin: 1.35em 0;
    border: 1px solid var(--border);
    border-radius: 6px;
    background: var(--code-bg);
    color: var(--code-fg);
    padding: 1em 1.12em;
    overflow: visible;
    white-space: pre-wrap;
    font-size: var(--export-code-size);
    line-height: 1.62;
  }

  .share-export-content :global(pre code),
  .share-export-content :global(.astro-code),
  .share-export-content :global(.astro-code span) {
    background: transparent !important;
    color: var(--code-fg) !important;
    font-size: inherit;
  }

  .share-export-content :global(blockquote) {
    border-left: 4px solid var(--accent);
    padding-left: 1em;
    color: var(--muted-foreground);
  }

  .share-export-card[data-export-card-theme="minimal"] {
    box-shadow: none;
  }
</style>

<script>
  import { toPng } from "html-to-image";

  const exportThemes = {
    light: {
      background: "#f7f8fb",
      foreground: "#1f2937",
      accent: "#3b82f6",
      muted: "#e5e7eb",
      mutedForeground: "#6b7280",
      border: "#dbe3ee",
      codeBg: "#eef2f7",
      codeFg: "#111827",
    },
    dark: {
      background: "#0f172a",
      foreground: "#e5e7eb",
      accent: "#60a5fa",
      muted: "#1e293b",
      mutedForeground: "#94a3b8",
      border: "#334155",
      codeBg: "#111827",
      codeFg: "#e5e7eb",
    },
    minimal: {
      background: "#ffffff",
      foreground: "#111827",
      accent: "#2563eb",
      muted: "#f3f4f6",
      mutedForeground: "#6b7280",
      border: "#e5e7eb",
      codeBg: "#f6f7f9",
      codeFg: "#111827",
    },
  } as const;

  async function waitForImages(root: HTMLElement) {
    const images = Array.from(root.querySelectorAll("img"));
    await Promise.all(
      images.map(async image => {
        if (image.complete && image.naturalWidth > 0) return;
        try {
          await image.decode();
        } catch {
          // Ignore a single failed image so text export can still proceed.
        }
      })
    );
  }

  function applyExportSettings(root: HTMLElement, width: string, themeName: string) {
    const theme = exportThemes[themeName as keyof typeof exportThemes] ?? exportThemes.light;
    const stage = document.querySelector("#share-export-stage");
    root.style.width = `${width}px`;
    root.style.setProperty("--export-width", `${width}px`);
    root.style.setProperty("--background", theme.background);
    root.style.setProperty("--foreground", theme.foreground);
    root.style.setProperty("--accent", theme.accent);
    root.style.setProperty("--muted", theme.muted);
    root.style.setProperty("--muted-foreground", theme.mutedForeground);
    root.style.setProperty("--border", theme.border);
    root.style.setProperty("--code-bg", theme.codeBg);
    root.style.setProperty("--code-fg", theme.codeFg);
    root.style.backgroundColor = theme.background;
    root.style.color = theme.foreground;
    root.dataset.exportCardSize = width;
    root.dataset.exportCardTheme = themeName;

    if (stage instanceof HTMLElement) {
      const maxPreviewWidth = Math.min(window.innerWidth - 96, 1120);
      const scale = Math.min(1, maxPreviewWidth / Number(width));
      stage.style.setProperty("--export-width", `${width}px`);
      stage.style.transform = `scale(${scale})`;
      stage.style.marginBottom = `${root.offsetHeight * (scale - 1)}px`;
    }
  }

  function populateExportContent() {
    const title = document.querySelector("#share-source-title");
    const meta = document.querySelector("#share-source-meta");
    const tags = document.querySelector("#share-source-tags");
    const article = document.querySelector("#article");
    const exportTitle = document.querySelector("#share-export-title");
    const exportMeta = document.querySelector("#share-export-meta");
    const exportTags = document.querySelector("#share-export-tags");
    const exportContent = document.querySelector("#share-export-content");

    if (
      !(title instanceof HTMLElement) ||
      !(article instanceof HTMLElement) ||
      !(exportTitle instanceof HTMLElement) ||
      !(exportMeta instanceof HTMLElement) ||
      !(exportTags instanceof HTMLElement) ||
      !(exportContent instanceof HTMLElement)
    ) {
      return false;
    }

    exportTitle.innerHTML = "";
    exportMeta.innerHTML = "";
    exportTags.innerHTML = "";
    exportContent.innerHTML = "";

    exportTitle.appendChild(title.cloneNode(true));

    if (meta instanceof HTMLElement) {
      const metaClone = meta.cloneNode(true) as HTMLElement;
      metaClone.querySelectorAll("svg").forEach((node: Element) => node.remove());
      exportMeta.appendChild(metaClone);
    }

    if (tags instanceof HTMLElement) {
      const tagsClone = tags.cloneNode(true) as HTMLElement;
      exportTags.append(...Array.from(tagsClone.children));
    }

    const articleClone = article.cloneNode(true) as HTMLElement;
    articleClone
      .querySelectorAll(".copy-code, .heading-link, script")
      .forEach((node: Element) => node.remove());
    articleClone.querySelectorAll("img").forEach((image: HTMLImageElement) => {
      const src = image.getAttribute("src");
      if (!src || src.startsWith("data:") || /^https?:\/\//.test(src)) return;
      image.src = new URL(src, window.location.origin).href;
    });
    exportContent.appendChild(articleClone);

    return true;
  }

  function setupShareTools() {
    const copyButton = document.querySelector("[data-copy-link]");
    const exportButton = document.querySelector("[data-export-image]");
    const modal = document.querySelector("#share-export-modal");
    const closeButton = document.querySelector("[data-export-close]");
    const downloadButton = document.querySelector("[data-export-download]");
    const sizeSelect = document.querySelector("[data-export-size]");
    const themeSelect = document.querySelector("[data-export-theme]");
    const exportRoot = document.querySelector("#share-export-root");
    const feedback = document.querySelector("[data-share-feedback]");

    const setFeedback = (message: string) => {
      if (feedback) feedback.textContent = message;
      window.setTimeout(() => {
        if (feedback && feedback.textContent === message) feedback.textContent = "";
      }, 2200);
    };

    if (copyButton instanceof HTMLButtonElement) {
      copyButton.onclick = async () => {
        const url = copyButton.dataset.url;
        if (!url) return;

        try {
          await navigator.clipboard.writeText(url);
          setFeedback("链接已复制");
        } catch {
          setFeedback("复制失败");
        }
      };
    }

    const refreshPreview = () => {
      if (
        !(exportRoot instanceof HTMLElement) ||
        !(sizeSelect instanceof HTMLSelectElement) ||
        !(themeSelect instanceof HTMLSelectElement)
      ) {
        return;
      }
      applyExportSettings(exportRoot, sizeSelect.value, themeSelect.value);
    };

    const closeModal = () => {
      if (!(modal instanceof HTMLElement)) return;
      modal.classList.add("hidden");
      modal.classList.remove("flex");
      modal.setAttribute("aria-hidden", "true");
      document.body.style.overflow = "";
    };

    const openModal = () => {
      if (!(modal instanceof HTMLElement)) return;
      if (!populateExportContent()) {
        setFeedback("生成失败");
        return;
      }
      refreshPreview();
      modal.classList.remove("hidden");
      modal.classList.add("flex");
      modal.setAttribute("aria-hidden", "false");
      document.body.style.overflow = "hidden";
    };

    if (exportButton instanceof HTMLButtonElement) {
      exportButton.onclick = openModal;
    }

    if (closeButton instanceof HTMLButtonElement) {
      closeButton.onclick = closeModal;
    }

    if (modal instanceof HTMLElement) {
      modal.addEventListener("click", event => {
        if (event.target === modal) closeModal();
      });
    }

    document.addEventListener("keydown", event => {
      if (event.key === "Escape") closeModal();
    });

    if (sizeSelect instanceof HTMLSelectElement) {
      sizeSelect.onchange = refreshPreview;
    }

    if (themeSelect instanceof HTMLSelectElement) {
      themeSelect.onchange = refreshPreview;
    }

    if (downloadButton instanceof HTMLButtonElement) {
      downloadButton.onclick = async () => {
        if (!(exportRoot instanceof HTMLElement)) {
          setFeedback("生成失败");
          return;
        }

        downloadButton.disabled = true;
        setFeedback("长图生成中...");
        refreshPreview();
        const backgroundColor =
          exportRoot.style.getPropertyValue("--background").trim() || "#ffffff";
        try {
          await waitForImages(exportRoot);
          await new Promise(requestAnimationFrame);
          const dataUrl = await toPng(exportRoot, {
            cacheBust: true,
            pixelRatio: 1,
            backgroundColor,
            skipFonts: true,
          });
          const link = document.createElement("a");
          const slug = window.location.pathname.split("/").filter(Boolean).pop() || "post";
          link.download = `${slug}-longshot.png`;
          link.href = dataUrl;
          link.click();
          setFeedback("长图已下载");
        } catch (error) {
          console.error("Failed to export image:", error);
          setFeedback("生成失败");
        } finally {
          downloadButton.disabled = false;
        }
      };
    }
  }

  document.addEventListener("astro:page-load", setupShareTools);
  setupShareTools();
</script>
